SUMMARY="The Enlightenment Foundation Libraries"
DESCRIPTION="EFL is a collection of libraries for building graphical applications: \
Evas (canvas), Edje (themes), Ecore (main loop and system integration), \
Elementary (widgets), Emotion (media playback), Eina, Eet and more.

This build draws its windows with the Haiku application kit, plays sound \
through the media kit and uses GStreamer for media playback."
HOMEPAGE="https://www.enlightenment.org"
COPYRIGHT="2002-2026 Enlightenment Project and contributors"
LICENSE="BSD (2-clause)
	GNU LGPL v2.1
	GNU GPL v2
	Zlib"
REVISION="8"
SOURCE_URI="git+https://github.com/ablyssx74/efl.git#503c49191fb62b944474646cdaeb7ca9fadd338e"
SOURCE_DIR="efl"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES=""

