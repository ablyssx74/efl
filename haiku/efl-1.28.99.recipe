REQUIRES_devel="
	efl == $portVersion base
	# the .pc files of EFL refer to these
	devel:libcrypto
	devel:libdbus_1
	devel:libfontconfig
	devel:libfreetype
	devel:libfribidi
	devel:libharfbuzz
	devel:libjpeg
	devel:libluajit_5.1
	devel:libpng16
	devel:libsdl2
	devel:libsndfile
	devel:libssl
	devel:libz
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libcrypto
	devel:libcurl
	devel:libdbus_1
	devel:libexecinfo
	devel:libfontconfig
	devel:libfreetype
	devel:libfribidi
	devel:libgif
	devel:libgstapp_1.0
	devel:libgstaudio_1.0
	devel:libgstbase_1.0
	devel:libgstpbutils_1.0
	devel:libgstreamer_1.0
	devel:libgsttag_1.0
	devel:libgstvideo_1.0
	devel:libharfbuzz
	devel:libjpeg
	devel:libluajit_5.1
	devel:liblz4
	devel:libopenjp2
	devel:libpng16
	devel:libsdl2
	devel:libsndfile
	devel:libssl
	devel:libtiff
	devel:libwebp
	devel:libwebpdemux
	devel:libz
	"
BUILD_PREREQUIRES="
	cmd:gcc
	cmd:g++
	cmd:meson
	cmd:ninja
	cmd:pkg_config
	cmd:python3
	"

BUILD()
{
	# EFL tools created during the build want a home directory (~/.run), which
	# the build chroot does not have
	mkdir -p /boot/home

	rm -rf build
	meson setup build \
		--prefix=$prefix \
		--bindir=$relativeBinDir \
		--libdir=$relativeLibDir \
		--datadir=$relativeDataDir \
		--includedir=$relativeIncludeDir \
		--sysconfdir=$relativeSettingsDir \
		--buildtype=plain \
		-Dbuild-tests=false \
		-Dbuild-examples=false \
		-Dnls=false \
		-Dsystemd=false \
		-Dx11=false \
		-Dwl=false \
		-Dfb=false \
		-Ddrm=false \
		-Dbuffer=false \
		-Dinput=false \
		-Deeze=false \
		-Dphysics=false \
		-Davahi=false \
		-Dlibmount=false \
		-Dopengl=none \
		-Dsdl=true \
		-Daudio=true \
		-Dgstreamer=true \
		-Dpulseaudio=false \
		-Dpipewire=false \
		-Dedje-sound-and-video=true \
		-Dlua-interpreter=luajit \
		-Dbindings= \
		-Devas-loaders-disabler=pdf,ps,raw,rsvg,xcf,gst,json,avif,heif,jxl
	ninja -C build
}

INSTALL()
{
	meson install -C build --no-rebuild

	# only exactness installs to a top-level share directory
	mkdir -p $dataDir
	mv $prefix/share/exactness $dataDir/
	rmdir $prefix/share

	prepareInstalledDevelLibs libecore libecore_audio libecore_con libecore_evas libecore_file libecore_imf libecore_imf_evas libecore_input libecore_input_evas libecore_ipc libector libedje libeet libefl libefreet libefreet_mime libefreet_trash libeina libeio libeldbus libelementary libembryo libemile libemotion libeo libeo_dbg libeolian libethumb libethumb_client libevas libexactness_play libexactness_record
	fixPkgconfig

	packageEntries devel \
		$developDir
}
