	devel:libecore_evas = 1.28.99 compat >= 1
	devel:libecore_file = 1.28.99 compat >= 1
	devel:libecore_imf = 1.28.99 compat >= 1
	devel:libecore_imf_evas = 1.28.99 compat >= 1
	devel:libecore_input = 1.28.99 compat >= 1
	devel:libecore_input_evas = 1.28.99 compat >= 1
	devel:libecore_ipc = 1.28.99 compat >= 1
	devel:libector = 1.28.99 compat >= 1
	devel:libedje = 1.28.99 compat >= 1
	devel:libeet = 1.28.99 compat >= 1
	devel:libefl = 1.28.99 compat >= 1
	devel:libefreet = 1.28.99 compat >= 1
	devel:libefreet_mime = 1.28.99 compat >= 1
	devel:libefreet_trash = 1.28.99 compat >= 1
	devel:libeina = 1.28.99 compat >= 1
	devel:libeio = 1.28.99 compat >= 1
	devel:libeldbus = 1.28.99 compat >= 1
	devel:libelementary = 1.28.99 compat >= 1
	devel:libembryo = 1.28.99 compat >= 1
	devel:libemile = 1.28.99 compat >= 1
	devel:libemotion = 1.28.99 compat >= 1
	devel:libeo = 1.28.99 compat >= 1
	devel:libeo_dbg = 1.28.99 compat >= 1
	devel:libeolian = 1.28.99 compat >= 1
	devel:libethumb = 1.28.99 compat >= 1
	devel:libethumb_client = 1.28.99 compat >= 1
	devel:libevas = 1.28.99 compat >= 1
	devel:libexactness_play = 1.28.99 compat >= 1
	devel:libexactness_record = 1.28.99 compat >= 1
