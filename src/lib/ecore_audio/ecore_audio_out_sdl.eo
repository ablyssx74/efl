class @beta Ecore.Audio.Out.Sdl extends Ecore.Audio.Out
{
   [[Ecore audio output using SDL audio, for platforms without PulseAudio or PipeWire (e.g. Haiku).]]
   c_prefix: ecore_audio_obj_out_sdl;
   event_c_prefix: ecore_audio_out_sdl;
   implements {
      Efl.Object.constructor;
      Efl.Object.destructor;
      Ecore.Audio.paused { set; }
      @empty Ecore.Audio.format { set; get; }
      @empty Ecore.Audio.source { set; get; }
      Ecore.Audio.Out.input_attach;
      Ecore.Audio.Out.input_detach;
   }
   events {
      context,ready: void; [[Called when the output is ready for playback.]]
      context,fail: void; [[Called when the output cannot be used.]]
   }
}
